# ============================================================
# V2 ローカル開発用 環境変数テンプレート
#
#   cp env/v2.local.env.example env/v2.local.env
#   （値を埋めて使う。v2.local.env はgit管理外）
# ============================================================

# --- Notion（V2専用インテグレーション）---
# https://www.notion.so/my-integrations で作成したシークレット
# ⚠️ V1 の NOTION_API_KEY は使わない。誤ってV1のDBを触る事故を防ぐため
NOTION_V2_API_KEY=

# 手で作ったページのID（URLの末尾32文字。?v= 以降は含めない）
# ⚠️ ルートページはV2用インテグレーションに接続しておくこと
#    （ページ右上「…」→ 接続）
NOTION_V2_ROOT_PAGE_ID=
NOTION_V2_MYPAGE_ROOT_ID=
NOTION_V2_SCHOOLPAGE_ROOT_ID=

# --- Notion データベースID ---
# notion_db_create.py の実行後、出力された値を貼る
NOTION_V2_SCHOOL_DB_ID=
NOTION_V2_USER_DB_ID=
NOTION_V2_SUBJECT_DB_ID=
NOTION_V2_SCHOOL_MEMBER_DB_ID=
NOTION_V2_LESSON_STUDY_DB_ID=
NOTION_V2_PRACTICE_EXAMPLE_DB_ID=
NOTION_V2_DAILY_LEARNING_DB_ID=
NOTION_V2_LESSON_STUDY_REFLECTION_DB_ID=
NOTION_V2_RESEARCH_QUESTION_DB_ID=
NOTION_V2_TEACHER_MONTHLY_STATS_DB_ID=

# --- Redis ---
# compose 内のサービス名で解決する。ローカルから直接繋ぐ場合は localhost:6379
REDIS_URL=redis://redis:6379/0

# --- Telegram（V2の窓口Bot・フェーズ3で使う）---
V2_TELEGRAM_BOT_TOKEN=
V2_TELEGRAM_SECRET_TOKEN=

# --- LLM（フェーズ2で使う。プロバイダ未選定 → TODO B-1）---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=

# 用途別にモデルを分ける場合に指定（空なら OPENAI_LLM_MODEL を使う）
V2_MODEL_EXTRACT=
V2_MODEL_ASK=

# --- Cloudflare R2（メディア保存。V1と同じバケットを使ってよい）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_FOLDER=
R2_PUBLIC_URL_BASE=

# --- 文字起こし（Gemini。V1と同じキーを使ってよい）---
# 無いと音声が無言で失敗する。必須
GEMINI_API_KEY=
# 月あたりの呼び出し上限。超えたら文字起こしを止める（暴走の歯止め。
# Google の制限ではない）。単位は呼び出し回数で、30秒ごとに1回数えるため
# 音声が長いほど増える: 5分の音声1本 = 13回
GEMINI_MONTHLY_LIMIT=20000

# --- 8分類（V1から引き継ぎ）---
# CATEGORY_MODE: rule / embed / hybrid
CHROMA_DIR=
CATEGORY_MODE=

# --- Slack（Bot Token方式。2026-10-09決定）---
#
# ⚠️ Webhook方式はやめた。V2_SLACK_WEBHOOK_URL は使わない。
#    ファイル添付もチャンネルの振り分けもWebhookではできない。
#
# 必要なスコープ: chat:write（投稿）+ files:write（写真・動画の添付）
# スコープを足したらアプリを再インストールする。
# 投稿先チャンネルにBotを招待すること（/invite）。忘れると not_in_channel
V2_SLACK_BOT_TOKEN=
# 学校ごとの投稿先。**ここに無い学校はSlackに投稿しない**（既定の投稿先は無い）
#   キー : School の**ページID**（学校名ではない。ハイフン有無は問わない）
#   値   : Slack の**チャンネルID**（`#名前` は使わない。リネームで届かなくなる）
# 例: {"4002e6dcc84a81dea8d7c848876b287a": "C09ABCD1234"}
# ⚠️ 外側をクォートで囲まないこと（クォートごと値になりJSONが壊れる）
V2_SLACK_CHANNEL_MAP=
