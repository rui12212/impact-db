# ============================================================
# V2 ローカル開発用 環境変数テンプレート
#
#   cp env/v2.local.env.example env/v2.local.env
#   （値を埋めて使う。v2.local.env はgit管理外）
# ============================================================

# --- Notion（V2専用インテグレーション）---
# https://www.notion.so/my-integrations で作成したシークレット
# ⚠️ V1 の NOTION_API_KEY は使わない。誤ってV1のDBを触る事故を防ぐため
NOTION_V2_API_KEY=

# 手で作ったページのID（URLの末尾32文字。?v= 以降は含めない）
# ⚠️ ルートページはV2用インテグレーションに接続しておくこと
#    （ページ右上「…」→ 接続）
NOTION_V2_ROOT_PAGE_ID=
NOTION_V2_MYPAGE_ROOT_ID=
NOTION_V2_SCHOOLPAGE_ROOT_ID=

# --- Notion データベースID ---
# notion_db_create.py の実行後、出力された値を貼る
NOTION_V2_SCHOOL_DB_ID=
NOTION_V2_USER_DB_ID=
NOTION_V2_SUBJECT_DB_ID=
NOTION_V2_SCHOOL_MEMBER_DB_ID=
NOTION_V2_LESSON_STUDY_DB_ID=
NOTION_V2_PRACTICE_EXAMPLE_DB_ID=
NOTION_V2_DAILY_LEARNING_DB_ID=
NOTION_V2_LESSON_STUDY_REFLECTION_DB_ID=
NOTION_V2_RESEARCH_QUESTION_DB_ID=
NOTION_V2_TEACHER_MONTHLY_STATS_DB_ID=

# --- Redis ---
# compose 内のサービス名で解決する。ローカルから直接繋ぐ場合は localhost:6379
REDIS_URL=redis://redis:6379/0

# --- Telegram（V2の窓口Bot・フェーズ3で使う）---
V2_TELEGRAM_BOT_TOKEN=
V2_TELEGRAM_SECRET_TOKEN=

# --- LLM（フェーズ2で使う。プロバイダ未選定 → TODO B-1）---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=

# 用途別にモデルを分ける場合に指定（空なら OPENAI_LLM_MODEL を使う）
V2_MODEL_EXTRACT=
V2_MODEL_ASK=

# --- Cloudflare R2（メディア保存。V1と同じバケットを使ってよい）---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_FOLDER=
R2_PUBLIC_URL_BASE=

# --- Slack（振り返りの要約投稿。投稿先は未定 → TODO B-3）---
V2_SLACK_WEBHOOK_URL=
