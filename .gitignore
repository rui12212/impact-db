# .gitignore

# macOS system files
.DS_Store
**/.DS_Store
.env
.env.*
*.env

# 環境変数ディレクトリ（中身は全て秘密。サンプルだけ許可）
# ディレクトリ自体を除外すると ! で戻せないため env/* と書く
env/*
!env/*.example

/creds/
creds/*

# Gemini API usage tracker
.gemini_usage.json

# Log files that may contain sensitive information
docs/log/

# Runtime-generated data (should not be in Git)
.chroma_categories/
.runtime/

# Claude Code workspace
.claude/

memory/

# Python cache
__pycache__/
*.pyc
*.pyo
.chroma_categories/
